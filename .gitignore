# Decompiled game code and anything extracted from the game. Never commit.
_decompiled/

# Build output, and your local install path
bin/
obj/
__pycache__/
.venv/
runs/
*.mp4
plugin/GameDir.props

# Markdown docs stay local for now, except the showcase README
*.md
!README.md

# Hugging Face upload folder (models and video, built from runs/)
goi-rl/

# The README's screenshot tool (not part of the agent)
scripts/readme_shots.py

# Upstream sources fetched by scripts/fetch_box2d.sh, and native builds
third_party/
build/

# This machine's GPU sharing settings (scripts/cuda_run.sh sources it when present)
scripts/gpu_env.local.sh
# Frozen per-run copies of scripts/train_jax.py (a run's launcher must not change under it)
scripts/train_jax_*.py
*.orig
