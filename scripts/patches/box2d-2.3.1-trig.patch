+/// goi: the sine and cosine b2Rot uses. b2_trigMode 0 (stock): the C library's sinf/cosf, whose last bit
+/// differs between libraries (glibc 2.39 misrounds ~1.4% of angles; the game's MSVC CRT is unknown).
+/// 1: (float32)sin((double)x), the correctly rounded value, which the JAX port reproduces exactly.
+extern int32 b2_trigMode;
+inline float32 b2Sin(float32 x) { return b2_trigMode ? (float32)sin((double)x) : sinf(x); }
+inline float32 b2Cos(float32 x) { return b2_trigMode ? (float32)cos((double)x) : cosf(x); }
