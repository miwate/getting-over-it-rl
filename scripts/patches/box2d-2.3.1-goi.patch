 // Find TOI contacts and solve them.
+// goi: Unity's TOI pair rule. Bullets keep stock semantics; otherwise one side must be a
+// Continuous dynamic body and the other static or kinematic.
+static bool b2UnityTOIPair(const b2Body* a, const b2Body* b)
+{
+	if (a->IsBullet() || b->IsBullet())
+	{
+		return true;
+	}
+	if (b->GetType() != b2_dynamicBody)
+	{
+		return a->IsContinuous();
+	}
+	if (a->GetType() != b2_dynamicBody)
+	{
+		return b->IsContinuous();
+	}
+	return false;
+}
